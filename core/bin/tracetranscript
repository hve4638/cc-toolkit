#!/usr/bin/env node
// tracetranscript launcher — runs the engine bundled in the skill folder (node-only, no deps).
// core exposes <plugin-root>/bin on PATH, so `tracetranscript …` works anywhere.
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
await import(join(dirname(fileURLToPath(import.meta.url)), '..', 'skills', 'tracetranscript', 'scripts', 'tracetranscript.mjs'))
  .catch(e => { process.stderr.write(`tracetranscript: ${e?.message ?? e}\n`); process.exit(1); });
