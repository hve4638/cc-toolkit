{
  "addons": [
    {
      "path": "addon/banaction/addon.mjs",
      "rules": {
        "rule:banaction": {
          "events": [
            "PreToolUse"
          ]
        }
      }
    },
    {
      "path": "addon/writing-context-hint/addon.mjs",
      "rules": {
        "writing-context-hint": {
          "events": [
            "PostToolUse"
          ],
          "enabledByDefault": true
        }
      }
    }
  ]
}
