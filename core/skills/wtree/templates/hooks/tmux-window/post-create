#!/bin/sh
# wtree post-create hook — opens a tmux window per new worktree.
# Env: WT_PATH(worktree path) WT_BRANCH(branch) WT_PARENT(parent branch)
#      WT_REPO(repo root) WT_INTERACTIVE(1 on a terminal run)

[ -n "${TMUX:-}" ] || exit 0   # outside tmux, do nothing

{FOCUS}

{PREFIX}

win=$(tmux new-window $detach -P -F '#{window_id}' -c "$WT_PATH" -n "${prefix}${WT_BRANCH}") || exit 0

{COMMAND}
