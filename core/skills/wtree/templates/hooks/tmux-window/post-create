#!/bin/sh
# wtree post-create hook — opens a tmux window per new worktree.
# Env: WTREE_PATH(worktree path) WTREE_BRANCH(branch) WTREE_REPO(repo root)
#      WTREE_INTERACTIVE(1 on a terminal run) WTREE_VERB(new|open)

[ -n "${TMUX:-}" ] || exit 0   # outside tmux, do nothing

{FOCUS}

{PREFIX}

win=$(tmux new-window $detach -P -F '#{window_id}' -c "$WTREE_PATH" -n "${prefix}${WTREE_BRANCH}") || exit 0

{COMMAND}
