#!/usr/bin/env node
// todo — 워크스페이스 docs/todo 의 얽힘(의존 그래프)과 해결 순서를 보여준다.
// rule-of-workspace 스킬의 RULE_OF_TODO.md 형식을 읽는다. 의존성 없는 단일 파일.
//
// 사용: todo [경로]   — 경로는 워크스페이스 루트·docs/todo·그 하위 어디든. 생략 시 cwd 에서 위로 탐색.
import { readdirSync, readFileSync, statSync, existsSync } from 'node:fs';
import { join, resolve, dirname } from 'node:path';

process.stdout.on('error', () => process.exit(0)); // `| head` 류 파이프 조기 종료 시 EPIPE 무시

const arg = process.argv[2];
if (arg === '-h' || arg === '--help') {
  process.stdout.write('사용: todo [경로]  — docs/todo 의 의존 그래프와 해결 순서를 출력\n');
  process.exit(0);
}

// ---- docs/todo 위치 결정: 인자(기본 cwd)에서 자신→조상 순으로 찾는다 ----
// docs/todo 자체나 그 하위를 받아도 조상 걷기가 같은 디렉터리에 닿는다.
function findTodoDir(start) {
  let dir = resolve(start);
  while (true) {
    const cand = join(dir, 'docs', 'todo');
    if (existsSync(cand) && statSync(cand).isDirectory()) return cand;
    const parent = dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

const todoDir = findTodoDir(arg ?? process.cwd());
if (!todoDir) {
  process.stderr.write(`todo: docs/todo 를 찾지 못함 (기준: ${resolve(arg ?? process.cwd())})\n`);
  process.exit(1);
}

// ---- frontmatter 손 파싱 (형식이 좁아 YAML 라이브러리 불요) ----
// 지원: `key: 값`, 인라인 배열 `[a, b]`, 블록 배열(다음 줄들의 `- 항목`).
// description 외의 필드는 꼬리 주석(` #…`)을 벗긴다 — 값에 # 가 올 일이 없는 필드들이다.
function parseFrontmatter(text) {
  const lines = text.split(/\r?\n/);
  if (lines[0]?.trim() !== '---') return null;
  const end = lines.findIndex((l, i) => i > 0 && l.trim() === '---');
  if (end < 0) return null;
  const fm = {};
  let pendingKey = null;
  for (const raw of lines.slice(1, end)) {
    const listItem = raw.match(/^\s*-\s+(.*)$/);
    if (pendingKey && listItem) { fm[pendingKey].push(unquote(listItem[1])); continue; }
    pendingKey = null;
    const kv = raw.match(/^([A-Za-z_][\w-]*):\s*(.*)$/);
    if (!kv) continue;
    const key = kv[1];
    let val = kv[2];
    if (key !== 'description') val = val.replace(/\s+#.*$/, '').trim();
    if (val === '') { fm[key] = []; pendingKey = key; continue; }
    if (key !== 'description' && val.startsWith('[')) {
      fm[key] = val.replace(/^\[|\]$/g, '').split(',').map(s => unquote(s)).filter(Boolean);
    } else {
      fm[key] = unquote(val);
    }
  }
  return fm;
}
const unquote = s => s.trim().replace(/^['"]|['"]$/g, '');

// ---- 수집 ----
// TODO.md·frontmatter 가 깨진 폴더도 '파싱 불가' 노드로 그래프에 남긴다 —
// 실재하는 폴더에 대한 의존이 "완료로 간주" 로 새지 않고, 고치는 일 자체가 선행 작업으로 보인다.
const todos = new Map(); // 폴더명 -> {desc, priority, status, repos, depends}
const parseWarns = [];   // '이름: 사유'
const missingDeps = [];  // '이름: 없는 의존'
for (const ent of readdirSync(todoDir, { withFileTypes: true })) {
  if (!ent.isDirectory()) continue;
  const md = join(todoDir, ent.name, 'TODO.md');
  let fm = null;
  if (!existsSync(md)) parseWarns.push(`${ent.name}: TODO.md 없음`);
  else if (!(fm = parseFrontmatter(readFileSync(md, 'utf8')))) parseWarns.push(`${ent.name}: frontmatter 없음`);
  todos.set(ent.name, {
    desc: typeof fm?.description === 'string' ? fm.description : '',
    priority: typeof fm?.priority === 'string' && fm.priority ? fm.priority : 'normal',
    status: fm ? (typeof fm.status === 'string' && fm.status ? fm.status : 'pending') : 'invalid',
    repos: Array.isArray(fm?.repos) ? fm.repos
      : typeof fm?.repos === 'string' && fm.repos ? [fm.repos] : [],
    depends: Array.isArray(fm?.depends) ? [...new Set(fm.depends)]
      : typeof fm?.depends === 'string' && fm.depends ? [fm.depends] : [],
  });
}

if (todos.size === 0) {
  process.stdout.write('todo 없음\n');
  process.exit(0);
}

// ---- DONE.md 원장: 여기 있는 이름은 확인된 완료 ----
// 줄 형식은 RULE_OF_TODO.md 의 `YYYY-MM-DD  <폴더명> — <description>`.
const doneNames = new Set();
{
  const doneMd = join(todoDir, 'DONE.md');
  if (existsSync(doneMd)) {
    for (const line of readFileSync(doneMd, 'utf8').split(/\r?\n/)) {
      const m = line.match(/^\d{4}-\d{2}-\d{2}\s+(\S+)/);
      if (m) doneNames.add(m[1]);
    }
  }
}

// ---- 그래프: 폴더가 없는 의존은 완료로 간주하되, DONE.md 에도 없으면 경고 (오타·미생성 신호) ----
for (const [name, t] of todos) {
  t.deps = t.depends.filter(d => {
    if (todos.has(d)) return true;
    if (!doneNames.has(d)) missingDeps.push(`${name}: '${d}' 없음`);
    return false;
  });
}
const blocks = new Map(); // 이름 -> 이것에 의존하는 것들
for (const [name, t] of todos) {
  for (const d of t.deps) {
    if (!blocks.has(d)) blocks.set(d, []);
    blocks.get(d).push(name);
  }
}

// ---- Kahn 위상 정렬: 순서가 곧 해결 순서. 남는 노드는 순환 ----
const prioRank = { critical: 0, high: 1, normal: 2, low: 3 };
const byPrio = (a, b) =>
  (prioRank[todos.get(a).priority] ?? 2) - (prioRank[todos.get(b).priority] ?? 2) || a.localeCompare(b);
const indeg = new Map([...todos.keys()].map(n => [n, todos.get(n).deps.length]));
const ready = [...todos.keys()].filter(n => indeg.get(n) === 0).sort(byPrio);
const order = [];
const queue = [...ready];
while (queue.length) {
  const n = queue.shift();
  order.push(n);
  const next = [];
  for (const m of blocks.get(n) ?? []) {
    indeg.set(m, indeg.get(m) - 1);
    if (indeg.get(m) === 0) next.push(m);
  }
  queue.push(...next.sort(byPrio));
}
const cyclic = [...todos.keys()].filter(n => !order.includes(n));

// 남은 노드에서 순환 경로 추출: 각 노드에서 미해소 의존을 따라가다 재방문 지점이 곧 순환.
// 순환에 걸리기만 하고 그 안에 있지는 않은 노드(순환 뒤에 줄 선 노드)는 경로만 지나가고 순환으로 잡히지 않는다.
const cyclicSet = new Set(cyclic);
const cycles = [];
{
  const seen = new Set();
  for (const n of [...cyclic].sort()) {
    if (seen.has(n)) continue;
    const path = [];
    let cur = n;
    while (cur !== undefined && !seen.has(cur) && !path.includes(cur)) {
      path.push(cur);
      cur = todos.get(cur).deps.find(d => cyclicSet.has(d));
    }
    if (cur !== undefined && path.includes(cur)) cycles.push([...path.slice(path.indexOf(cur)), cur]);
    for (const p of path) seen.add(p);
  }
}

// ---- 출력 ----
const tty = process.stdout.isTTY;
const paint = (code, s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : s);
const dim = s => paint('2', s), bold = s => paint('1', s), yellow = s => paint('33', s);
const width = s => [...s].reduce((w, ch) => w + (/[ᄀ-ᇿ⺀-꓏가-힣豈-﫿＀-｠]/.test(ch) ? 2 : 1), 0);
const pad = (s, n) => s + ' '.repeat(Math.max(0, n - width(s)));

const counts = {};
for (const t of todos.values()) counts[t.status] = (counts[t.status] ?? 0) + 1;
const statusOrder = ['pending', 'in-progress', 'on-hold'];
const statusKeys = [...statusOrder.filter(s => counts[s]),
  ...Object.keys(counts).filter(s => !statusOrder.includes(s)).sort()];
const countStr = statusKeys.map(s => `${s} ${counts[s]}`).join(' · ');
process.stdout.write(`${todos.size}개 (${countStr})\n`);

const nameW = Math.max(...[...todos.keys()].map(width)) + 2;
const prioW = Math.max(...[...todos.values()].map(t => width(t.priority))) + 2;
const statW = Math.max(...[...todos.values()].map(t => width(t.status))) + 2;
const repoStr = t => t.repos.join(',') || '-';
const repoW = Math.max(...[...todos.values()].map(t => width(repoStr(t)))) + 2;
function line(n) {
  const t = todos.get(n);
  const deps = t.deps.length ? dim(`  ← ${t.deps.join(', ')}`) : '';
  const unblocks = !t.deps.length && blocks.get(n)?.length ? dim(`  → ${blocks.get(n).join(', ')}`) : '';
  let row = `  ${pad(n, nameW)}${pad(t.priority, prioW)}${pad(t.status, statW)}${pad(repoStr(t), repoW)}${t.desc}${deps}${unblocks}`;
  if (t.status === 'on-hold') row = dim(row.replace(/\x1b\[\d+m/g, ''));
  return row + '\n';
}
const readySet = new Set(ready);
process.stdout.write(`\n${bold('착수 가능')}\n`);
for (const n of order.filter(n => readySet.has(n))) process.stdout.write(line(n));
const waiting = order.filter(n => !readySet.has(n));
if (waiting.length || cyclic.length) {
  process.stdout.write(`\n${bold('대기')} ${dim('(위에서 아래가 해결 순서)')}\n`);
  for (const n of [...waiting, ...cyclic.sort(byPrio)]) process.stdout.write(line(n));
}
function warnGroup(title, items) {
  if (!items.length) return;
  process.stdout.write(`\n${bold(yellow(title))}\n`);
  for (const it of items) process.stdout.write(`${yellow(`- ${it}`)}\n`);
}
warnGroup('파싱 경고:', parseWarns);
warnGroup('사라진 의존 경고: (DONE.md 에도 없는 이름 — 오타이거나 미생성)', missingDeps);
warnGroup('순환 의존 경고:', cycles.map(c => c.join(' → ')));
